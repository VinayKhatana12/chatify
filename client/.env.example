# ── API ────────────────────────────────────────────────────────
# Base URL used by the pre-configured axios instance (src/lib/api.ts).
# Keep "/api" in development — the Vite dev server proxies it to the
# backend (see vite.config.ts). Point it at the deployed API in production,
# e.g. https://api.chatify.example/api
VITE_API_URL=/api

# ── Socket.io ──────────────────────────────────────────────────
# Leave empty to connect to the current origin (works with the Vite
# dev-server proxy). Set explicitly for production, e.g. https://api.chatify.example
VITE_SOCKET_URL=
