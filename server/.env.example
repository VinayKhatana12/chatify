# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────────────
# Local MongoDB or a MongoDB Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/chatify

# ── Auth (JWT) ──────────────────────────────────────────────────
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Auth cookie ─────────────────────────────────────────────────
COOKIE_NAME=chatify_token
# Cookie lifetime in milliseconds (default 7 days).
COOKIE_MAX_AGE_MS=604800000

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
CLIENT_URL=http://localhost:5173

# ── Cloudinary (image messages — optional) ──────────────────────
# Leave empty to disable media uploads; POST /api/messages/send/:userId
# with an image file will respond 503 until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
